{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.ctey.dev"
        }
      ],
      "destination": "https://ctey.dev/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ctey.dev"
        }
      ],
      "destination": "https://ctey.dev/:path*",
      "statusCode": 301
    }
  ]
}
